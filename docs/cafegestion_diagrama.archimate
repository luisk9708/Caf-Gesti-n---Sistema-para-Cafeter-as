<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:archimate="http://www.archimatetool.com/archimate"
 name="CaféGestión - Arquitectura" id="id-model-cafegestion" version="5.0.0">

  <folder name="Application" id="id-folder-application" type="application">
    <element xsi:type="archimate:ApplicationInterface" name="[ Interfaz de Usuario ] (HTML + CSS)" id="id-ui"/>
    <element xsi:type="archimate:ApplicationComponent" name="[ app.js ] (Punto de entrada del sistema)" id="id-appjs"/>
    <element xsi:type="archimate:ApplicationService" name="[ productoManager.js ] (Controlador de la lógica CRUD)" id="id-manager"/>
    <element xsi:type="archimate:DataObject" name="[ Singleton de productos ] (Instancia única de gestión)" id="id-singleton"/>
    <element xsi:type="archimate:DataObject" name="[ storage.js ] (Gestión del almacenamiento local)" id="id-storage"/>
  </folder>

  <folder name="Other" id="id-folder-other" type="other">
    <element xsi:type="archimate:Grouping" name="Frontend (UI + app.js)" id="id-frontend"/>
    <element xsi:type="archimate:Grouping" name="Backend lógico (productoManager, storage, singleton)" id="id-backend"/>
  </folder>

  <folder name="Relations" id="id-folder-relations" type="relations">
    <element xsi:type="archimate:ServingRelationship" id="id-rel1" source="id-ui" target="id-appjs"/>
    <element xsi:type="archimate:AssignmentRelationship" id="id-rel2" source="id-appjs" target="id-manager"/>
    <element xsi:type="archimate:AccessRelationship" id="id-rel3" source="id-manager" target="id-singleton"/>
    <element xsi:type="archimate:AccessRelationship" id="id-rel4" source="id-manager" target="id-storage"/>
    <element xsi:type="archimate:CompositionRelationship" id="id-rel5" source="id-frontend" target="id-ui"/>
    <element xsi:type="archimate:CompositionRelationship" id="id-rel6" source="id-frontend" target="id-appjs"/>
    <element xsi:type="archimate:CompositionRelationship" id="id-rel7" source="id-backend" target="id-manager"/>
    <element xsi:type="archimate:CompositionRelationship" id="id-rel8" source="id-backend" target="id-singleton"/>
    <element xsi:type="archimate:CompositionRelationship" id="id-rel9" source="id-backend" target="id-storage"/>
  </folder>

  <folder name="Views" id="id-folder-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" name="Vista de Arquitectura CaféGestión" id="id-view1">
      <child xsi:type="archimate:DiagramObject" id="id-diagram-frontend" textAlignment="1" archimateElement="id-frontend">
        <bounds x="100" y="20" width="400" height="120"/>
        <child xsi:type="archimate:DiagramObject" id="id-diagram-ui" archimateElement="id-ui">
          <bounds x="20" y="40" width="150" height="60"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="id-diagram-appjs" archimateElement="id-appjs">
          <bounds x="200" y="40" width="150" height="60"/>
        </child>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-diagram-backend" textAlignment="1" archimateElement="id-backend">
        <bounds x="100" y="180" width="500" height="180"/>
        <child xsi:type="archimate:DiagramObject" id="id-diagram-manager" archimateElement="id-manager">
          <bounds x="40" y="40" width="200" height="60"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="id-diagram-singleton" archimateElement="id-singleton">
          <bounds x="40" y="120" width="200" height="50"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="id-diagram-storage" archimateElement="id-storage">
          <bounds x="300" y="80" width="180" height="60"/>
        </child>
      </child>
    </element>
  </folder>
</archimate:model>
